{
  "name": "@settleup/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "clean": "node --eval \"import { rmSync } from 'node:fs'; for (const path of ['.react-router', 'build', 'playwright-report', 'test-results']) rmSync(path, { force: true, recursive: true })\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-router/node": "^8.3.0",
    "@settleup/contracts": "0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@react-router/dev": "^8.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
