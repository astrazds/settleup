{
  "name": "settleup",
  "description": "No-login, private-by-link group expense splitter for one shared-cost event.",
  "homepage": "https://repos.astrazds.net/astrazds/settleup",
  "bugs": {
    "url": "https://repos.astrazds.net/astrazds/settleup/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://repos.astrazds.net/astrazds/settleup.git"
  },
  "keywords": [
    "expense-splitting",
    "hono",
    "settlement",
    "sqlite",
    "typescript"
  ],
  "author": "Andrejs Strazds <andrejs@astrazds.com>",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "esbuild src/server.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "deploy": "npm run build",
    "pretest:smoke": "rm -f .data/smoke.sqlite .data/smoke.sqlite-* && npm run build",
    "pretest:smoke:critical": "rm -f .data/smoke.sqlite .data/smoke.sqlite-* && npm run build",
    "pretest:smoke:extended": "rm -f .data/smoke.sqlite .data/smoke.sqlite-* && npm run build",
    "test:smoke": "playwright test",
    "test:smoke:critical": "playwright test --project=critical",
    "test:smoke:extended": "playwright test --project=extended",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run build:client",
    "typecheck": "tsc --noEmit",
    "validate:html": "html-validate docs/design/mockups.html",
    "deploy:dry-run": "npm run build",
    "verify": "npm test && npm run test:coverage && npm run typecheck && npm run test:smoke && npm run validate:html && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "html-validate": "^11.4.0",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
