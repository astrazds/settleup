{
  "name": "settleup",
  "description": "No-login, private-by-link group expense splitter for one shared-cost event.",
  "homepage": "https://repos.astrazds.net/astrazds/settleup",
  "bugs": {
    "url": "https://repos.astrazds.net/astrazds/settleup/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://repos.astrazds.net/astrazds/settleup.git"
  },
  "keywords": [
    "cloudflare-workers",
    "d1",
    "expense-splitting",
    "hono",
    "settlement",
    "typescript"
  ],
  "author": "Andrejs Strazds <andrejs@astrazds.com>",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "pretest:smoke": "wrangler d1 migrations apply settleup --local",
    "pretest:smoke:critical": "wrangler d1 migrations apply settleup --local",
    "pretest:smoke:extended": "wrangler d1 migrations apply settleup --local",
    "test:smoke": "playwright test",
    "test:smoke:critical": "playwright test --project=critical",
    "test:smoke:extended": "playwright test --project=extended",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:html": "html-validate docs/design/mockups.html",
    "deploy:dry-run": "wrangler deploy --dry-run --minify --outdir dist-dry-run",
    "verify": "npm test && npm run test:coverage && npm run typecheck && npm run test:smoke && npm run validate:html && sh -c 'trap \"rm -rf dist-dry-run\" EXIT; npm run deploy:dry-run'"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "html-validate": "^11.4.0",
    "miniflare": "^4.20260526.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.4.0"
  }
}
