{
  "name": "settleup-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "20.x || 22.x || >=24",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "dev:api": "npm run dev",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { force: true, recursive: true })\"",
    "build": "npm run clean && tsc -p tsconfig.server.json",
    "build:server": "npm run build",
    "build:all": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.12.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  }
}
