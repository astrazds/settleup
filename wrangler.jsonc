{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "settleup",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "settleup",
      "database_id": "fcca3b4a-7993-4c3b-bcbb-9bf7d538b2bc",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_REALTIME",
        "class_name": "EventRealtimeRoom"
      }
    ]
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "migrations": [
    {
      "tag": "v1_event_realtime_room",
      "new_sqlite_classes": [
        "EventRealtimeRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
